# Supabase connection for the Saloni app.
#
# These two values are deliberately committed. The publishable key is designed
# to be public: Vite inlines it into the browser bundle at build time, so it is
# readable by anyone using the app no matter where it is stored. What actually
# protects the data is the row-level security in supabase/migrations/0002.
#
# The SECRET key (sb_secret_… / service_role) bypasses every one of those
# policies. It must never appear in this file, in the app, or in this repository.
VITE_SUPABASE_URL=https://nicdmspejrvruszlwhvm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eRn58Oq07-aEww1zsw5ztA_chwPRXY_
