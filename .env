# Supabase connection for the Saloni app.
#
# These two values are deliberately committed. The publishable key is designed
# to be public: Vite inlines it into the browser bundle at build time, so it is
# readable by anyone using the app no matter where it is stored. What actually
# protects the data is the row-level security in supabase/migrations/0002.
#
# The SECRET key (sb_secret_… / service_role) bypasses every one of those
# policies. It must never appear in this file, in the app, or in this repository.
VITE_SUPABASE_URL=https://nicdmspejrvruszlwhvm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eRn58Oq07-aEww1zsw5ztA_chwPRXY_

# Set to true once an SMS provider is configured in Supabase (Authentication →
# Providers → Phone). Until then the sign-in screen offers e-mail only, rather
# than showing a mobile-number option that cannot work.
VITE_AUTH_PHONE_OTP=false

# Public half of the VAPID key pair that signs push messages. Public by design,
# exactly like the Supabase key above — it is what the push service checks our
# messages against. The PRIVATE half belongs in Supabase secrets and nowhere
# else. Leave this empty and the app makes no promise to notify anybody and
# never asks permission; supabase/README.md has how to generate the pair.
VITE_VAPID_PUBLIC_KEY=BLxdXENQ1bkuOb6_Fix78Qu8hPtXsdrcaOKqx1UMMXTDioh2pWpC4SN43_bD7HUrw3TRur31zKlTkUMqx5WmQoY
