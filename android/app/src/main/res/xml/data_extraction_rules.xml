<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of Saloni's leaves the phone in a backup or a phone-to-phone transfer.

  The WebView keeps the Supabase sign-in session in its local storage, under
  the app's data folder. A backup carried that session to wherever the backup
  went — a Google Drive copy, a laptop running `adb backup`, a new phone — and
  whoever restored it was signed in as the owner. android:allowBackup="false"
  in the manifest stops cloud and adb backups; on Android 12 and later it does
  NOT stop device-to-device transfer, which is what these rules are for.

  Nothing is lost by it: everything the app shows lives in the database, and
  signing in on a new phone takes one passcode.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
